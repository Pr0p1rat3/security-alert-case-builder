# Backend settings use the SACB_ prefix.
SACB_ENVIRONMENT=development
SACB_DATABASE_URL=postgresql+psycopg://sacb:sacb@localhost:5432/sacb
SACB_REDIS_URL=redis://localhost:6379/0
SACB_JWT_SECRET=replace-with-a-long-random-secret
SACB_JWT_EXPIRE_MINUTES=60
SACB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
SACB_EVIDENCE_STORAGE_PATH=./data/evidence
SACB_MAX_UPLOAD_BYTES=10485760
SACB_SEED_DEMO_DATA=true
SACB_SEED_ADMIN_EMAIL=admin@example.com
SACB_SEED_ADMIN_PASSWORD=ChangeMe123!

# Future enrichment providers should read API keys from environment variables.
# No external provider is enabled in the MVP.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
GREYNOISE_API_KEY=
